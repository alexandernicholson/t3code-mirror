# Fork privacy defaults. Copying this file does not enable T3-hosted services.
# Configure only services you operate or explicitly trust. Do not add secrets here.
T3CODE_CLOUD_ENABLED=false
T3CODE_TELEMETRY_ENABLED=false
T3CODE_ENABLE_UPSTREAM_UPDATES=false

# Optional self-hosted cloud configuration. Requires T3CODE_CLOUD_ENABLED=true.
# T3CODE_CLERK_PUBLISHABLE_KEY=your-public-key
# T3CODE_CLERK_JWT_TEMPLATE=your-jwt-template
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=your-oauth-client-id
# T3CODE_RELAY_URL=https://relay.example.com
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Optional fork-owned Expo updates. No upstream project or update URL is supplied.
# T3CODE_MOBILE_UPDATES_URL=https://updates.example.com
# T3CODE_MOBILE_EAS_PROJECT_ID=your-eas-project-id
# T3CODE_MOBILE_EXPO_OWNER=your-expo-account

# Optional signed Apple builds, using your own team and relying-party domains.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_IOS_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/fork.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=auth.example.com
# T3CODE_CLERK_RELYING_PARTY=auth.example.com
